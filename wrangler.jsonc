{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "fruition-landing",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "fruitionservices.io/*", "zone_name": "fruitionservices.io" },
    { "pattern": "www.fruitionservices.io/*", "zone_name": "fruitionservices.io" }
  ],
  "compatibility_date": "2025-03-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "fruition-landing"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
