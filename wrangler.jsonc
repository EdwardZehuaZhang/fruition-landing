{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "fruition-landing",
  "routes": [
    { "pattern": "fruitionservices.io/*", "zone_name": "fruitionservices.io" },
    { "pattern": "www.fruitionservices.io/*", "zone_name": "fruitionservices.io" }
  ],
  "compatibility_date": "2025-03-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      // OpenNext incremental (ISR) cache — see open-next.config.ts.
      "binding": "NEXT_INC_CACHE_KV_NAMESPACE",
      "id": "74a7eb0e0e4542e8a9acdbc178a849af"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "fruition-landing"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
