# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Sanity dataset backups (large binaries, not for git)
backups/

# QA screenshot/diff artifacts (regenerated locally)
qa/

# Codex local config (may contain API tokens)
.codex/config.toml

# Cloudflare / OpenNext
.open-next/
.wrangler/
.dev.vars
cloudflare-env.d.ts

# brainstorming visual companion
.superpowers/

# dark-mode QA screenshots
qa/darkmode/

# Sanity Studio build output — was committed by mistake (62MB, removed 2026-08-21).
# The Studio is served by Next at /studio; this directory is never deployed.
/dist/

# Local worktrees checked out inside the repo
n8n-badge-wt/
