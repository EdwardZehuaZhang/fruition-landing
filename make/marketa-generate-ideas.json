{
  "name": "Marketa — generate blog ideas (daily)",
  "flow": [
    {
      "id": 1,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "{{SUPABASE_URL}}/rest/v1/content_chunks",
        "serializeUrl": false,
        "method": "get",
        "headers": [
          { "name": "apikey", "value": "{{SUPABASE_SERVICE_ROLE_KEY}}" },
          { "name": "Authorization", "value": "Bearer {{SUPABASE_SERVICE_ROLE_KEY}}" }
        ],
        "qs": [
          { "name": "select", "value": "title:metadata->>title,source_path,industry:metadata->>industry,created_at" },
          { "name": "source_type", "value": "eq.sanity" },
          { "name": "created_at", "value": "gt.{{formatDate(addDays(now; -30); \"YYYY-MM-DD\")}}" },
          { "name": "order", "value": "created_at.desc" },
          { "name": "limit", "value": "50" }
        ],
        "bodyType": "",
        "parseResponse": true,
        "timeout": "40",
        "shareCookies": false,
        "ca": "",
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "followAllRedirects": false
      },
      "onerror": [
        {
          "id": 101,
          "module": "builtin:Break",
          "version": 1,
          "parameters": {},
          "mapper": {},
          "metadata": { "designer": { "x": 0, "y": 200, "name": "Retry: Supabase recent blogs" } }
        }
      ],
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Supabase: recent blogs (PostgREST — replaces the n8n Postgres SELECT over content_chunks, last 30 days of sanity-sourced chunks)"
        }
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "mapper": { "array": "{{1.data}}" },
      "metadata": { "designer": { "x": 300, "y": 0, "name": "Iterate recent-blog rows" } }
    },
    {
      "id": 3,
      "module": "util:TextAggregator",
      "version": 1,
      "parameters": { "feeder": 2, "rowSeparator": "\n" },
      "mapper": { "value": "- [{{ifempty(2.industry; \"general\")}}] {{ifempty(2.title; 2.source_path)}}" },
      "metadata": { "designer": { "x": 600, "y": 0, "name": "Build prompt context (recent_context)" } }
    },
    {
      "id": 4,
      "module": "json:TransformToJSON",
      "version": 1,
      "parameters": { "space": "" },
      "mapper": {
        "object": {
          "model": "claude-opus-4-7",
          "max_tokens": 2000,
          "system": "You are Marketa, Fruition's marketing agent. Generate 5 blog ideas daily. 80% industry-focused (workflows, pains, decision frameworks), 20% product (monday.com, HubSpot, Atlassian). AEO-first: each idea must be a query someone asks Google AI Overviews or ChatGPT. Avoid topics already covered in recent_context. Respond ONLY with a valid JSON array.",
          "messages": [
            {
              "role": "user",
              "content": "Recent published topics to avoid duplicating:\n{{ifempty(3.text; \"(no recent posts)\")}}\n\nGenerate 5 new blog ideas as a JSON array. Each item: {\"title\": string, \"brief\": string (2-3 sentence angle), \"target_keyword\": string, \"industry\": one of [Construction, HR, Real Estate, Marketing, SaaS, Professional Services, Manufacturing, Product]}. Return ONLY the JSON array, no prose."
            }
          ]
        }
      },
      "metadata": { "designer": { "x": 900, "y": 0, "name": "Build Claude request body (JSON-safe)" } }
    },
    {
      "id": 5,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "https://api.anthropic.com/v1/messages",
        "serializeUrl": false,
        "method": "post",
        "headers": [
          { "name": "x-api-key", "value": "{{CLAUDE_API_KEY}}" },
          { "name": "anthropic-version", "value": "2023-06-01" },
          { "name": "content-type", "value": "application/json" }
        ],
        "qs": [],
        "bodyType": "raw",
        "contentType": "application/json",
        "data": "{{4.json}}",
        "parseResponse": true,
        "timeout": "300",
        "shareCookies": false,
        "ca": "",
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "followAllRedirects": false
      },
      "onerror": [
        {
          "id": 102,
          "module": "builtin:Break",
          "version": 1,
          "parameters": {},
          "mapper": {},
          "metadata": { "designer": { "x": 1200, "y": 200, "name": "Retry: Claude ideas" } }
        }
      ],
      "metadata": { "designer": { "x": 1200, "y": 0, "name": "Claude: generate 5 ideas" } }
    },
    {
      "id": 6,
      "module": "util:ComposeTransformer",
      "version": 1,
      "parameters": {},
      "mapper": {
        "value": "{\"ideas\": {{trim(replace(replace(first(map(5.data.content; \"text\"; \"type\"; \"text\")); \"/^```json\\s*/i\"; \"\"); \"/```\\s*$/\"; \"\"))}}}"
      },
      "metadata": { "designer": { "x": 1500, "y": 0, "name": "Strip ``` fences, wrap array as {ideas: [...]}" } }
    },
    {
      "id": 7,
      "module": "json:ParseJSON",
      "version": 1,
      "parameters": { "type": "" },
      "mapper": { "json": "{{6.value}}" },
      "metadata": { "designer": { "x": 1800, "y": 0, "name": "Parse ideas array (errors here = Claude returned non-JSON)" } }
    },
    {
      "id": 8,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "mapper": { "array": "{{7.ideas}}" },
      "metadata": { "designer": { "x": 2100, "y": 0, "name": "Iterate 5 ideas" } }
    },
    {
      "id": 9,
      "module": "json:TransformToJSON",
      "version": 1,
      "parameters": { "space": "" },
      "mapper": {
        "object": {
          "long_text_mm3grk84": { "text": "{{8.brief}}" },
          "text_mm3gzj88": "{{8.target_keyword}}",
          "dropdown_mm3gb7wm": { "labels": [ "{{8.industry}}" ] },
          "dropdown_mm3jh58b": { "labels": [ "Idea proposed" ] }
        }
      },
      "metadata": { "designer": { "x": 2400, "y": 0, "name": "Stringify monday column_values (vals)" } }
    },
    {
      "id": 10,
      "module": "json:TransformToJSON",
      "version": 1,
      "parameters": { "space": "" },
      "mapper": {
        "object": {
          "query": "mutation ($board: ID!, $group: String!, $name: String!, $vals: JSON!) { create_item(board_id: $board, group_id: $group, item_name: $name, column_values: $vals) { id } }",
          "variables": {
            "board": "5028637584",
            "group": "topics",
            "name": "{{8.title}}",
            "vals": "{{9.json}}"
          }
        }
      },
      "metadata": { "designer": { "x": 2700, "y": 0, "name": "Build monday create_item GraphQL body" } }
    },
    {
      "id": 11,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "https://api.monday.com/v2",
        "serializeUrl": false,
        "method": "post",
        "headers": [
          { "name": "Authorization", "value": "{{MONDAY_API_TOKEN}}" },
          { "name": "API-Version", "value": "2024-01" },
          { "name": "Content-Type", "value": "application/json" }
        ],
        "qs": [],
        "bodyType": "raw",
        "contentType": "application/json",
        "data": "{{10.json}}",
        "parseResponse": true,
        "timeout": "40",
        "shareCookies": false,
        "ca": "",
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "followAllRedirects": false
      },
      "onerror": [
        {
          "id": 103,
          "module": "builtin:Ignore",
          "version": 1,
          "parameters": {},
          "mapper": {},
          "metadata": { "designer": { "x": 3000, "y": 200, "name": "Skip failed idea, keep creating the rest" } }
        }
      ],
      "metadata": { "designer": { "x": 3000, "y": 0, "name": "monday: create item (board 5028637584, group topics)" } }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scheduling": { "type": "daily", "time": "09:00" },
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "eu1.make.com"
  }
}
