{
  "name": "Marketa — revise blog (webhook from monday stage change)",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": { "hook": "{{MARKETA_REVISE_HOOK_ID}}", "maxResults": 1 },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Webhook: marketa-revise (POST from /api/webhooks/monday-blog when Stage → Edits requested; body: { pulseId })"
        }
      }
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "https://api.monday.com/v2",
        "serializeUrl": false,
        "method": "post",
        "headers": [
          { "name": "Authorization", "value": "{{MONDAY_API_TOKEN}}" },
          { "name": "API-Version", "value": "2024-01" },
          { "name": "Content-Type", "value": "application/json" }
        ],
        "qs": [],
        "bodyType": "raw",
        "contentType": "application/json",
        "data": "{\"query\":\"query ($id: [ID!]!) { items(ids: $id) { name column_values { id type text value } } }\",\"variables\":{\"id\":[\"{{1.pulseId}}\"]}}",
        "parseResponse": true,
        "timeout": "40",
        "shareCookies": false,
        "ca": "",
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "followAllRedirects": false
      },
      "onerror": [
        {
          "id": 101,
          "module": "builtin:Break",
          "version": 1,
          "parameters": {},
          "mapper": {},
          "metadata": { "designer": { "x": 300, "y": 200, "name": "Retry: monday fetch" } }
        }
      ],
      "metadata": { "designer": { "x": 300, "y": 0, "name": "monday: fetch item" } }
    },
    {
      "id": 3,
      "module": "util:SetVariables",
      "version": 1,
      "parameters": {},
      "mapper": {
        "variables": [
          { "name": "pulseId", "value": "{{1.pulseId}}" },
          { "name": "title", "value": "{{2.data.data.items[1].name}}" },
          { "name": "draft", "value": "{{first(map(2.data.data.items[1].column_values; \"text\"; \"id\"; \"long_text_mm3gj0s8\"))}}" },
          { "name": "notes", "value": "{{first(map(2.data.data.items[1].column_values; \"text\"; \"id\"; \"long_text_mm3g2bp9\"))}}" }
        ],
        "scope": "roundtrip"
      },
      "metadata": { "designer": { "x": 600, "y": 0, "name": "Normalize item (draft + edit notes)" } }
    },
    {
      "id": 4,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": null,
      "metadata": { "designer": { "x": 900, "y": 0, "name": "Guard: draft + notes present?" } },
      "routes": [
        {
          "flow": [
            {
              "id": 5,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "parameters": {},
              "filter": {
                "name": "missing draft or edit notes",
                "conditions": [
                  [ { "a": "{{3.draft}}", "o": "notexist" } ],
                  [ { "a": "{{3.notes}}", "o": "notexist" } ]
                ]
              },
              "mapper": {
                "status": "422",
                "body": "{\"ok\": false, \"error\": \"no existing draft to revise or no edit notes provided\", \"pulseId\": \"{{3.pulseId}}\"}",
                "headers": [ { "key": "Content-Type", "value": "application/json" } ]
              },
              "metadata": { "designer": { "x": 1200, "y": -150, "name": "Respond 422 (replaces n8n throw: 'no existing draft' / 'no edit notes')" } }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 6,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
              "filter": {
                "name": "draft and notes present",
                "conditions": [
                  [
                    { "a": "{{3.draft}}", "o": "exist" },
                    { "a": "{{3.notes}}", "o": "exist" }
                  ]
                ]
              },
              "mapper": {
                "url": "https://{{SANITY_PROJECT_ID}}.api.sanity.io/v2024-01-01/data/query/{{SANITY_DATASET}}",
                "serializeUrl": false,
                "method": "get",
                "headers": [],
                "qs": [ { "name": "query", "value": "*[_type==\"voiceGuide\"][0].body" } ],
                "bodyType": "",
                "parseResponse": true,
                "timeout": "40",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "useMtls": false,
                "followAllRedirects": false
              },
              "onerror": [
                {
                  "id": 102,
                  "module": "builtin:Resume",
                  "version": 1,
                  "parameters": {},
                  "mapper": { "statusCode": "200", "data": { "result": "(no voice guide)" } },
                  "metadata": { "designer": { "x": 1200, "y": 350, "name": "Voice guide unavailable → substitute placeholder" } }
                }
              ],
              "metadata": {
                "designer": {
                  "x": 1200,
                  "y": 150,
                  "name": "Fetch voice guide (Sanity GROQ — replaces the n8n legacy SELECT ... WHERE source_type='voice_guide'; the guide is intentionally not embedded in the brain)"
                }
              }
            },
            {
              "id": 7,
              "module": "json:TransformToJSON",
              "version": 1,
              "parameters": { "space": "" },
              "mapper": {
                "object": {
                  "model": "claude-opus-4-7",
                  "max_tokens": 4000,
                  "system": "You are Marketa revising a draft per reviewer feedback. Apply the requested changes precisely without rewriting unaffected sections. Preserve voice and cite markers. Follow voice guide.\n\nVOICE GUIDE:\n{{ifempty(6.data.result; \"(no voice guide)\")}}",
                  "messages": [
                    {
                      "role": "user",
                      "content": "Title: {{3.title}}\n\nCurrent draft:\n{{3.draft}}\n\nReviewer edit notes:\n{{3.notes}}\n\nReturn the full revised draft in markdown. Do not include any preamble."
                    }
                  ]
                }
              },
              "metadata": { "designer": { "x": 1500, "y": 150, "name": "Build Claude revise body" } }
            },
            {
              "id": 8,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
              "mapper": {
                "url": "https://api.anthropic.com/v1/messages",
                "serializeUrl": false,
                "method": "post",
                "headers": [
                  { "name": "x-api-key", "value": "{{CLAUDE_API_KEY}}" },
                  { "name": "anthropic-version", "value": "2023-06-01" },
                  { "name": "content-type", "value": "application/json" }
                ],
                "qs": [],
                "bodyType": "raw",
                "contentType": "application/json",
                "data": "{{7.json}}",
                "parseResponse": true,
                "timeout": "300",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "useMtls": false,
                "followAllRedirects": false
              },
              "onerror": [
                {
                  "id": 103,
                  "module": "builtin:Break",
                  "version": 1,
                  "parameters": {},
                  "mapper": {},
                  "metadata": { "designer": { "x": 1800, "y": 350, "name": "Retry: Claude revise" } }
                }
              ],
              "metadata": { "designer": { "x": 1800, "y": 150, "name": "Claude: revise draft" } }
            },
            {
              "id": 9,
              "module": "json:TransformToJSON",
              "version": 1,
              "parameters": { "space": "" },
              "mapper": {
                "object": {
                  "long_text_mm3gj0s8": { "text": "{{8.data.content[1].text}}" },
                  "long_text_mm3g2bp9": { "text": "" },
                  "dropdown_mm3jh58b": { "labels": [ "Draft ready" ] }
                }
              },
              "metadata": { "designer": { "x": 2100, "y": 150, "name": "Stringify column_values: revised text + CLEAR edit notes + stage Draft ready" } }
            },
            {
              "id": 10,
              "module": "json:TransformToJSON",
              "version": 1,
              "parameters": { "space": "" },
              "mapper": {
                "object": {
                  "query": "mutation ($board: ID!, $item: ID!, $vals: JSON!) { change_multiple_column_values(board_id: $board, item_id: $item, column_values: $vals) { id } }",
                  "variables": {
                    "board": "5028637584",
                    "item": "{{3.pulseId}}",
                    "vals": "{{9.json}}"
                  }
                }
              },
              "metadata": { "designer": { "x": 2400, "y": 150, "name": "Build monday patch GraphQL body" } }
            },
            {
              "id": 11,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
              "mapper": {
                "url": "https://api.monday.com/v2",
                "serializeUrl": false,
                "method": "post",
                "headers": [
                  { "name": "Authorization", "value": "{{MONDAY_API_TOKEN}}" },
                  { "name": "API-Version", "value": "2024-01" },
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "qs": [],
                "bodyType": "raw",
                "contentType": "application/json",
                "data": "{{10.json}}",
                "parseResponse": true,
                "timeout": "40",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "useMtls": false,
                "followAllRedirects": false
              },
              "onerror": [
                {
                  "id": 104,
                  "module": "builtin:Break",
                  "version": 1,
                  "parameters": {},
                  "mapper": {},
                  "metadata": { "designer": { "x": 2700, "y": 350, "name": "Retry: monday patch" } }
                }
              ],
              "metadata": { "designer": { "x": 2700, "y": 150, "name": "monday: patch revised + clear notes" } }
            },
            {
              "id": 12,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": "200",
                "body": "{\"ok\": true, \"pulseId\": \"{{3.pulseId}}\"}",
                "headers": [ { "key": "Content-Type", "value": "application/json" } ]
              },
              "metadata": { "designer": { "x": 3000, "y": 150, "name": "Respond 200 (mirrors n8n responseNode — caller waits for the revision)" } }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "eu1.make.com"
  }
}
