{
  "name": "Marketa: publish social (Ayrshare)",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": { "hook": "{{MARKETA_PUBLISH_SOCIAL_HOOK_ID}}", "maxResults": 1 },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Webhook: marketa-publish-social (body: { post, platforms[], mediaUrls?, scheduleDate?, idempotencyKey?, notes?, youTubeOptions?, pinterestOptions? })"
        }
      }
    },
    {
      "id": 2,
      "module": "json:TransformToJSON",
      "version": 1,
      "parameters": { "space": "" },
      "mapper": {
        "object": {
          "post": "{{ifempty(1.post; emptystring)}}",
          "platforms": "{{1.platforms}}",
          "mediaUrls": "{{if(length(1.mediaUrls) > 0; 1.mediaUrls; null)}}",
          "scheduleDate": "{{1.scheduleDate}}",
          "idempotencyKey": "{{1.idempotencyKey}}",
          "notes": "{{1.notes}}",
          "youTubeOptions": "{{1.youTubeOptions}}",
          "pinterestOptions": "{{1.pinterestOptions}}"
        }
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Build Ayrshare body (unset optional fields serialize as null — Ayrshare ignores nulls; n8n dropped the keys entirely)"
        }
      }
    },
    {
      "id": 3,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "https://api.ayrshare.com/api/post",
        "serializeUrl": false,
        "method": "post",
        "headers": [
          { "name": "Authorization", "value": "Bearer {{AYRSHARE_API_KEY}}" },
          { "name": "Content-Type", "value": "application/json" }
        ],
        "qs": [],
        "bodyType": "raw",
        "contentType": "application/json",
        "data": "{{2.json}}",
        "parseResponse": true,
        "timeout": "120",
        "shareCookies": false,
        "ca": "",
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "followAllRedirects": false
      },
      "onerror": [
        {
          "id": 101,
          "module": "builtin:Break",
          "version": 1,
          "parameters": {},
          "mapper": {},
          "metadata": { "designer": { "x": 600, "y": 200, "name": "Retry: Ayrshare post" } }
        }
      ],
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Ayrshare: POST /post (for X/Twitter add the two X-Twitter-OAuth1-* headers here)"
        }
      }
    },
    {
      "id": 4,
      "module": "gateway:WebhookRespond",
      "version": 1,
      "parameters": {},
      "mapper": {
        "status": "200",
        "body": "{\"ok\": true, \"ayrshareId\": \"{{3.data.id}}\", \"status\": \"{{3.data.status}}\"}",
        "headers": [ { "key": "Content-Type", "value": "application/json" } ]
      },
      "metadata": { "designer": { "x": 900, "y": 0, "name": "Respond 200 with Ayrshare result" } }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "eu1.make.com"
  }
}
