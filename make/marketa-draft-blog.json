{
  "name": "Marketa — draft blog (webhook from monday stage change)",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": { "hook": "{{MARKETA_DRAFT_HOOK_ID}}", "maxResults": 1 },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Webhook: marketa-draft (POST from /api/webhooks/monday-blog and /api/webhooks/slack-blog; body: pulseId + optional title/brief/target_keyword/industry)"
        }
      }
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "https://api.monday.com/v2",
        "serializeUrl": false,
        "method": "post",
        "headers": [
          { "name": "Authorization", "value": "{{MONDAY_API_TOKEN}}" },
          { "name": "API-Version", "value": "2024-01" },
          { "name": "Content-Type", "value": "application/json" }
        ],
        "qs": [],
        "bodyType": "raw",
        "contentType": "application/json",
        "data": "{\"query\":\"query ($id: [ID!]!) { items(ids: $id) { name column_values { id type text value } } }\",\"variables\":{\"id\":[\"{{1.pulseId}}\"]}}",
        "parseResponse": true,
        "timeout": "40",
        "shareCookies": false,
        "ca": "",
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "followAllRedirects": false
      },
      "onerror": [
        {
          "id": 101,
          "module": "builtin:Break",
          "version": 1,
          "parameters": {},
          "mapper": {},
          "metadata": { "designer": { "x": 300, "y": 200, "name": "Retry: monday fetch" } }
        }
      ],
      "metadata": { "designer": { "x": 300, "y": 0, "name": "monday: fetch item" } }
    },
    {
      "id": 3,
      "module": "util:SetVariables",
      "version": 1,
      "parameters": {},
      "mapper": {
        "variables": [
          { "name": "pulseId", "value": "{{1.pulseId}}" },
          { "name": "title", "value": "{{ifempty(1.title; 2.data.data.items[1].name)}}" },
          { "name": "brief", "value": "{{ifempty(1.brief; first(map(2.data.data.items[1].column_values; \"text\"; \"id\"; \"long_text_mm3grk84\")))}}" },
          { "name": "target_keyword", "value": "{{ifempty(1.target_keyword; first(map(2.data.data.items[1].column_values; \"text\"; \"id\"; \"text_mm3gzj88\")))}}" },
          { "name": "industry", "value": "{{ifempty(1.industry; ifempty(first(map(2.data.data.items[1].column_values; \"text\"; \"id\"; \"dropdown_mm3gb7wm\")); \"general\"))}}" }
        ],
        "scope": "roundtrip"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Normalize item (webhook body wins, monday fetch is fallback — sidesteps monday eventual-consistency race, cf. pulse 2714465661 on 2026-05-24)"
        }
      }
    },
    {
      "id": 4,
      "module": "gateway:WebhookRespond",
      "version": 1,
      "parameters": {},
      "mapper": {
        "status": "200",
        "body": "{\"ok\": true, \"accepted\": true, \"pulseId\": \"{{3.pulseId}}\"}",
        "headers": [ { "key": "Content-Type", "value": "application/json" } ]
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0,
          "name": "Respond 200 early (mirrors n8n responseMode onReceived — caller must not wait for the draft)"
        }
      }
    },
    {
      "id": 5,
      "module": "json:TransformToJSON",
      "version": 1,
      "parameters": { "space": "" },
      "mapper": {
        "object": {
          "model": "models/gemini-embedding-001",
          "content": { "parts": [ { "text": "{{3.title}} - {{3.brief}} - {{3.target_keyword}}" } ] },
          "taskType": "RETRIEVAL_QUERY",
          "outputDimensionality": 768
        }
      },
      "metadata": { "designer": { "x": 1200, "y": 0, "name": "Build Gemini embed body" } }
    },
    {
      "id": 6,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-embedding-001:embedContent",
        "serializeUrl": false,
        "method": "post",
        "headers": [
          { "name": "x-goog-api-key", "value": "{{GEMINI_API_KEY}}" },
          { "name": "Content-Type", "value": "application/json" }
        ],
        "qs": [],
        "bodyType": "raw",
        "contentType": "application/json",
        "data": "{{5.json}}",
        "parseResponse": true,
        "timeout": "40",
        "shareCookies": false,
        "ca": "",
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "followAllRedirects": false
      },
      "onerror": [
        {
          "id": 102,
          "module": "builtin:Break",
          "version": 1,
          "parameters": {},
          "mapper": {},
          "metadata": { "designer": { "x": 1500, "y": 200, "name": "Retry: Gemini embed" } }
        }
      ],
      "metadata": { "designer": { "x": 1500, "y": 0, "name": "Gemini: embed query (768-dim RETRIEVAL_QUERY)" } }
    },
    {
      "id": 7,
      "module": "json:TransformToJSON",
      "version": 1,
      "parameters": { "space": "" },
      "mapper": {
        "object": {
          "query_embedding": "{{6.data.embedding.values}}",
          "match_count": 8,
          "filter_industry": "{{lower(3.industry)}}"
        }
      },
      "metadata": { "designer": { "x": 1800, "y": 0, "name": "Build match_content_chunks RPC body" } }
    },
    {
      "id": 8,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "{{SUPABASE_URL}}/rest/v1/rpc/match_content_chunks",
        "serializeUrl": false,
        "method": "post",
        "headers": [
          { "name": "apikey", "value": "{{SUPABASE_SERVICE_ROLE_KEY}}" },
          { "name": "Authorization", "value": "Bearer {{SUPABASE_SERVICE_ROLE_KEY}}" },
          { "name": "Content-Type", "value": "application/json" }
        ],
        "qs": [],
        "bodyType": "raw",
        "contentType": "application/json",
        "data": "{{7.json}}",
        "parseResponse": true,
        "timeout": "40",
        "shareCookies": false,
        "ca": "",
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "followAllRedirects": false
      },
      "onerror": [
        {
          "id": 103,
          "module": "builtin:Break",
          "version": 1,
          "parameters": {},
          "mapper": {},
          "metadata": { "designer": { "x": 2100, "y": 200, "name": "Retry: brain retrieval" } }
        }
      ],
      "metadata": {
        "designer": {
          "x": 2100,
          "y": 0,
          "name": "Supabase: retrieve chunks (PostgREST RPC match_content_chunks — replaces n8n Postgres node; top 8 public chunks)"
        }
      }
    },
    {
      "id": 9,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "https://{{SANITY_PROJECT_ID}}.api.sanity.io/v2024-01-01/data/query/{{SANITY_DATASET}}",
        "serializeUrl": false,
        "method": "get",
        "headers": [],
        "qs": [ { "name": "query", "value": "*[_type==\"voiceGuide\"][0].body" } ],
        "bodyType": "",
        "parseResponse": true,
        "timeout": "40",
        "shareCookies": false,
        "ca": "",
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "followAllRedirects": false
      },
      "onerror": [
        {
          "id": 104,
          "module": "builtin:Resume",
          "version": 1,
          "parameters": {},
          "mapper": { "statusCode": "200", "data": { "result": "(no voice guide)" } },
          "metadata": { "designer": { "x": 2400, "y": 200, "name": "Voice guide unavailable → substitute placeholder, keep drafting" } }
        }
      ],
      "metadata": {
        "designer": {
          "x": 2400,
          "y": 0,
          "name": "Fetch voice guide (Sanity GROQ; add Authorization: Bearer <token> header if the dataset is private)"
        }
      }
    },
    {
      "id": 10,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "mapper": { "array": "{{8.data}}" },
      "metadata": { "designer": { "x": 2700, "y": 0, "name": "Iterate retrieved chunks" } }
    },
    {
      "id": 11,
      "module": "util:FunctionIncrement",
      "version": 1,
      "parameters": { "reset": "scenario" },
      "mapper": {},
      "metadata": { "designer": { "x": 3000, "y": 0, "name": "Source counter (1..N for [Source N] cite markers)" } }
    },
    {
      "id": 12,
      "module": "util:TextAggregator",
      "version": 1,
      "parameters": { "feeder": 10, "rowSeparator": "\n\n" },
      "mapper": { "value": "--- Source {{11.i}} (id: {{10.source_id}}) ---\n{{10.body}}" },
      "metadata": { "designer": { "x": 3300, "y": 0, "name": "Aggregate RAG context" } }
    },
    {
      "id": 13,
      "module": "json:TransformToJSON",
      "version": 1,
      "parameters": { "space": "" },
      "mapper": {
        "object": {
          "model": "claude-opus-4-7",
          "max_tokens": 8000,
          "tools": [ { "type": "web_search_20250305", "name": "web_search", "max_uses": 5 } ],
          "system": "You are Marketa, Fruition's marketing agent. Write AEO-optimised long-form blogs (2000+ words). Industry-focused over product-pitchy. Use the provided sources and cite them inline with [Source N] markers. Follow the Fruition voice guide strictly. Output markdown with H2/H3 headings, short paragraphs, no horizontal separators, no em-dash overuse, no AI-sounding boilerplate.\n\nVOICE GUIDE:\n{{ifempty(9.data.result; \"(no voice guide)\")}}",
          "messages": [
            {
              "role": "user",
              "content": "Title: {{3.title}}\n\nBrief: {{3.brief}}\n\nTarget keyword: {{3.target_keyword}}\n\nIndustry: {{3.industry}}\n\nRetrieved sources to draw from and cite:\n{{12.text}}\n\nWrite the full blog post now. Markdown format. Start with H1 then body."
            }
          ]
        }
      },
      "metadata": { "designer": { "x": 3600, "y": 0, "name": "Build Claude draft body (voice guide + brief + chunks)" } }
    },
    {
      "id": 14,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "https://api.anthropic.com/v1/messages",
        "serializeUrl": false,
        "method": "post",
        "headers": [
          { "name": "x-api-key", "value": "{{CLAUDE_API_KEY}}" },
          { "name": "anthropic-version", "value": "2023-06-01" },
          { "name": "content-type", "value": "application/json" }
        ],
        "qs": [],
        "bodyType": "raw",
        "contentType": "application/json",
        "data": "{{13.json}}",
        "parseResponse": true,
        "timeout": "300",
        "shareCookies": false,
        "ca": "",
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "followAllRedirects": false
      },
      "onerror": [
        {
          "id": 105,
          "module": "builtin:Break",
          "version": 1,
          "parameters": {},
          "mapper": {},
          "metadata": { "designer": { "x": 3900, "y": 200, "name": "Retry: Claude draft" } }
        }
      ],
      "metadata": { "designer": { "x": 3900, "y": 0, "name": "Claude: write draft (opus, 8000 tokens, web_search x5)" } }
    },
    {
      "id": 15,
      "module": "util:SetVariables",
      "version": 1,
      "parameters": {},
      "mapper": {
        "variables": [
          { "name": "draft", "value": "{{trim(join(map(14.data.content; \"text\"; \"type\"; \"text\"); emptystring))}}" }
        ],
        "scope": "roundtrip"
      },
      "metadata": {
        "designer": {
          "x": 4200,
          "y": 0,
          "name": "Extract draft text (join ALL text blocks — web_search responses interleave tool blocks)"
        }
      }
    },
    {
      "id": 16,
      "module": "json:TransformToJSON",
      "version": 1,
      "parameters": { "space": "" },
      "mapper": {
        "object": {
          "monday_item_id": "{{3.pulseId}}",
          "body": "{{15.draft}}",
          "updated_at": "{{now}}"
        }
      },
      "metadata": { "designer": { "x": 4500, "y": 0, "name": "Build blog_drafts upsert body" } }
    },
    {
      "id": 17,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "{{SUPABASE_URL}}/rest/v1/blog_drafts",
        "serializeUrl": false,
        "method": "post",
        "headers": [
          { "name": "apikey", "value": "{{SUPABASE_SERVICE_ROLE_KEY}}" },
          { "name": "Authorization", "value": "Bearer {{SUPABASE_SERVICE_ROLE_KEY}}" },
          { "name": "Content-Type", "value": "application/json" },
          { "name": "Prefer", "value": "resolution=merge-duplicates,return=minimal" }
        ],
        "qs": [ { "name": "on_conflict", "value": "monday_item_id" } ],
        "bodyType": "raw",
        "contentType": "application/json",
        "data": "{{16.json}}",
        "parseResponse": true,
        "timeout": "40",
        "shareCookies": false,
        "ca": "",
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "followAllRedirects": false
      },
      "onerror": [
        {
          "id": 106,
          "module": "builtin:Break",
          "version": 1,
          "parameters": {},
          "mapper": {},
          "metadata": { "designer": { "x": 4800, "y": 200, "name": "Retry: save full draft" } }
        }
      ],
      "metadata": {
        "designer": {
          "x": 4800,
          "y": 0,
          "name": "Supabase: save FULL draft (monday long_text truncates at ~2000 chars; auto-docs route reads this table)"
        }
      }
    },
    {
      "id": 18,
      "module": "json:TransformToJSON",
      "version": 1,
      "parameters": { "space": "" },
      "mapper": {
        "object": {
          "long_text_mm3gj0s8": { "text": "{{15.draft}}" },
          "dropdown_mm3jh58b": { "labels": [ "Draft ready" ] }
        }
      },
      "metadata": { "designer": { "x": 5100, "y": 0, "name": "Stringify monday column_values (vals)" } }
    },
    {
      "id": 19,
      "module": "json:TransformToJSON",
      "version": 1,
      "parameters": { "space": "" },
      "mapper": {
        "object": {
          "query": "mutation ($board: ID!, $item: ID!, $vals: JSON!) { change_multiple_column_values(board_id: $board, item_id: $item, column_values: $vals) { id } }",
          "variables": {
            "board": "5028637584",
            "item": "{{3.pulseId}}",
            "vals": "{{18.json}}"
          }
        }
      },
      "metadata": { "designer": { "x": 5400, "y": 0, "name": "Build monday patch GraphQL body" } }
    },
    {
      "id": 20,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "https://api.monday.com/v2",
        "serializeUrl": false,
        "method": "post",
        "headers": [
          { "name": "Authorization", "value": "{{MONDAY_API_TOKEN}}" },
          { "name": "API-Version", "value": "2024-01" },
          { "name": "Content-Type", "value": "application/json" }
        ],
        "qs": [],
        "bodyType": "raw",
        "contentType": "application/json",
        "data": "{{19.json}}",
        "parseResponse": true,
        "timeout": "40",
        "shareCookies": false,
        "ca": "",
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "followAllRedirects": false
      },
      "onerror": [
        {
          "id": 107,
          "module": "builtin:Break",
          "version": 1,
          "parameters": {},
          "mapper": {},
          "metadata": { "designer": { "x": 5700, "y": 200, "name": "Retry: monday patch" } }
        }
      ],
      "metadata": { "designer": { "x": 5700, "y": 0, "name": "monday: patch draft + stage (Draft ready)" } }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "eu1.make.com"
  }
}
