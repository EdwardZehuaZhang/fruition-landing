        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": \"query { boards(ids: [5028637584]) { items_page(limit: 100) { items { name column_values(ids: [\\\"color_mm3gj287\\\"]) { id text } } } } }\"\n}",
        "options": {}
      },
      "id": "monday-recent",
      "name": "monday: fetch recent items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "{{ MONDAY_CREDENTIAL_ID }}",
          "name": "monday.com"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract Published titles only — those are real recent blogs to avoid dupes.\nconst items = $input.first().json.data?.boards?.[0]?.items_page?.items || [];\nconst published = items.filter(it => {\n  const stage = it.column_values?.find(c => c.id === 'color_mm3gj287')?.text;\n  return stage === 'Published';\n});\nconst context = published.length\n  ? published.map(p => `- ${p.name}`).join('\\n')\n  : '(no previously published blogs)';\nreturn [{ json: { recent_context: context } }];"
      },
      "id": "build-context",
      "name": "Build context string",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-opus-4-7\",\n  \"max_tokens\": 2000,\n  \"system\": \"You are Marketa, Fruition's marketing agent. Generate 5 blog ideas. 80% industry-focused (workflows, pains, decision frameworks for monday.com / HubSpot / Atlassian implementations), 20% product. AEO-first: each idea must be a query someone asks Google AI Overviews or ChatGPT. Avoid topics already covered in recent_context. Respond ONLY with a valid JSON array. No prose, no markdown fence.\",\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"Recent published topics to avoid duplicating:\\n{{ $json.recent_context }}\\n\\nReturn a JSON array of 5 items. Each item: {\\\"title\\\": string, \\\"brief\\\": string (2-3 sentence angle), \\\"target_keyword\\\": string, \\\"industry\\\": one of [Construction, HR, Real Estate, Marketing, SaaS, Professional Services, Manufacturing, Product]}.\"\n  }]\n}",
        "options": {}
      },
      "id": "claude-ideas",
      "name": "Claude: generate 5 ideas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ],
      "credentials": {
        "anthropicApi": {
          "id": "{{ CLAUDE_CREDENTIAL_ID }}",
          "name": "Anthropic Claude"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.content?.[0]?.text || '[]';\nconst cleaned = raw.trim().replace(/^```json\\s*/i, '').replace(/```\\s*$/, '');\nconst ideas = JSON.parse(cleaned);\nif (!Array.isArray(ideas)) throw new Error('Expected array');\nreturn ideas.map(i => ({ json: i }));"
      },
      "id": "parse-ideas",
      "name": "Parse ideas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "API-Version",
              "value": "2024-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": \"mutation ($board: ID!, $group: String!, $name: String!, $vals: JSON!) { create_item(board_id: $board, group_id: $group, item_name: $name, column_values: $vals) { id } }\",\n  \"variables\": {\n    \"board\": \"5028637584\",\n    \"group\": \"topics\",\n    \"name\": {{ JSON.stringify($json.title) }},\n    \"vals\": {{ JSON.stringify(JSON.stringify({\n      \"long_text_mm3grk84\": { \"text\": $json.brief },\n      \"text_mm3gzj88\": $json.target_keyword,\n      \"dropdown_mm3gb7wm\": { \"labels\": [$json.industry] },\n      \"color_mm3gj287\": { \"label\": \"Idea proposed\" },\n      \"color_mm3gpz9w\": { \"label\": \"Explicit\" }\n    })) }}\n  }\n}",
        "options": {}
      },
